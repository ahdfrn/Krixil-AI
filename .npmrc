# npm's default "hoisted" install strategy hoists every workspace's dependencies into one shared
# root node_modules whenever it sees no *direct* version conflict for that package name. That
# broke cli/ here: ink (only cli depends on it) got hoisted to root/node_modules/ink, so ink's own
# bundled react-reconciler resolved root's React 19 (needed by apps/web) instead of the React 18
# nested under cli/node_modules that ink actually needs — two React copies loaded at once, a real
# crash ("Cannot read properties of undefined (reading 'ReactCurrentOwner')"), not a cosmetic
# warning. "nested" keeps each workspace's own dependency tree close to where it's used instead of
# hoisting everything blindly, which avoids this whole class of leak.
install-strategy=nested
