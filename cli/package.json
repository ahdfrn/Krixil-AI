{
  "name": "kirxil-cli",
  "version": "0.1.0",
  "description": "Kirxil AI CLI — autonomous software engineering agent, in your terminal",
  "type": "module",
  "bin": {
    "kirxil": "./dist/index.js",
    "krixil": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "execa": "^9.5.1",
    "figlet": "^1.11.4",
    "ink": "^5.1.0",
    "ink-text-input": "^6.0.0",
    "js-yaml": "^5.4.1",
    "react": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/figlet": "^1.7.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18"
  }
}
