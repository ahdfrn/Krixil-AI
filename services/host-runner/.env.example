# The one drive/folder this service will ever read, write, or run commands under. No approval,
# no sandbox — everything under this root is fully readable/writable/executable by the AI. See
# docs/architecture/coding-agent.md ("Real host-folder access") before changing this.
HOST_ROOT=D:\

# 127.0.0.1 only — never 0.0.0.0. This service has no auth of its own; it must stay unreachable
# from anything but this machine.
PORT=8002
