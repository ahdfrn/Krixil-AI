APP_ENV=development
APP_NAME=krixil-ai
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# Generate a real value: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=changeme-generate-a-real-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# These three hosts are "localhost" because that's correct when running uvicorn directly on
# your machine against the dockerized Postgres/Redis/MinIO (their ports are published to
# localhost). Inside docker-compose, the api container needs the Docker network hostnames
# ("postgres", "redis", "minio") instead — docker-compose.yml overrides these three for the
# api service specifically, so you don't need to (or want to) edit them for the Docker path.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=krixil
POSTGRES_USER=krixil
POSTGRES_PASSWORD=changeme
# Built from the POSTGRES_* vars above if left unset; override to point elsewhere.
DATABASE_URL=

REDIS_URL=redis://localhost:6379/0

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme123
MINIO_BUCKET=krixil-documents

# "mock" needs no key and always works. Set to "openai" plus OPENAI_API_KEY below to use a
# real OpenAI-compatible model (OpenAI itself, or any compatible endpoint via OPENAI_BASE_URL —
# self-hosted vLLM, OpenRouter, etc.).
MODEL_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Redis-backed recent-conversation cache used to build model context (Postgres stays the
# durable source of truth — see docs/architecture/phase0.md).
SHORT_TERM_MEMORY_MAX_MESSAGES=20
SHORT_TERM_MEMORY_TTL_SECONDS=86400

# Per-tenant, fixed-window, shared across /chat and /chat/stream.
RATE_LIMIT_CHAT_PER_MINUTE=30
