APP_ENV=development
APP_NAME=krixil-ai
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# Generate a real value: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=changeme-generate-a-real-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# These three hosts are "localhost" because that's correct when running uvicorn directly on
# your machine against the dockerized Postgres/Redis/MinIO (their ports are published to
# localhost). Inside docker-compose, the api container needs the Docker network hostnames
# ("postgres", "redis", "minio") instead — docker-compose.yml overrides these three for the
# api service specifically, so you don't need to (or want to) edit them for the Docker path.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=krixil
POSTGRES_USER=krixil
POSTGRES_PASSWORD=changeme
# Built from the POSTGRES_* vars above if left unset; override to point elsewhere.
DATABASE_URL=

REDIS_URL=redis://localhost:6379/0

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme123
MINIO_BUCKET=krixil-documents

# "mock" needs no key and always works. Set to "openai" plus OPENAI_API_KEY below to use a
# real OpenAI-compatible model (OpenAI itself, or any compatible endpoint via OPENAI_BASE_URL —
# self-hosted vLLM, OpenRouter, Moonshot's Kimi models, etc. — anything that speaks the same
# /chat/completions shape).
MODEL_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Moonshot's Kimi models are served over an OpenAI-compatible API, so they need no separate
# provider — just point OPENAI_* above at Moonshot instead of OpenAI. Uncomment and fill in a
# real Moonshot API key (platform.moonshot.ai) and the exact model name you actually have access
# to — double-check that name yourself; it's a real third-party catalog this file can't verify.
# OPENAI_BASE_URL=https://api.moonshot.ai/v1
# OPENAI_MODEL=kimi-k2-instruct
# OPENAI_EMBEDDING_MODEL= (Moonshot doesn't offer one — see ANTHROPIC_* below for the same
#   situation, and how it's handled: chat goes to the cloud model, embeddings stay on Ollama)

# Anthropic's real Claude models, over Anthropic's own Messages API — NOT OpenAI-compatible
# (different endpoint, different auth, different tool-call shape; see
# app/ai/anthropic_provider.py), so this is a separate provider, not a variant of OPENAI_* above.
# Set MODEL_PROVIDER=anthropic and a real key from console.anthropic.com. Anthropic has no
# embeddings endpoint at all — this provider always uses Ollama's for that (OLLAMA_* below still
# needs to be reachable, even if OLLAMA isn't the chat provider), so RAG/knowledge search keep
# working.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# Alternative to OPENAI_*/ANTHROPIC_* above: a fully local, private model via Ollama
# (https://ollama.com) — no third-party subscription, no data leaving your machine. Set
# MODEL_PROVIDER=ollama to use it instead (needs "ollama pull <model>" done first, and
# EMBEDDING_DIMENSION below changed to match your embedding model's real output size — see
# alembic/versions/0008_ollama_embedding_dim.py). Also the required embeddings backend whenever
# MODEL_PROVIDER=anthropic (see above), regardless of whether it's the selected chat provider.
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# OLLAMA_DEFAULT_MODEL=qwen2.5:7b
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Redis-backed recent-conversation cache used to build model context (Postgres stays the
# durable source of truth — see docs/architecture/phase0.md).
SHORT_TERM_MEMORY_MAX_MESSAGES=20
SHORT_TERM_MEMORY_TTL_SECONDS=86400

# Per-tenant, fixed-window, shared across /chat and /chat/stream.
RATE_LIMIT_CHAT_PER_MINUTE=30

# Agent loop budgets — see docs/architecture/phase4.md.
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=5
AGENT_MAX_EXECUTION_SECONDS=120

# How many tool calls a single chat turn may make (LOW-risk tools only — see
# docs/architecture/odysseus-parity.md Phase 4/Chat tool-calling).
CHAT_MAX_TOOL_CALLS=3

# Tracing is safe to leave on even with no collector reachable — see docs/architecture/phase5.md.
# localhost:4318 is correct for local (non-Docker) dev; docker-compose overrides this to the
# jaeger service, same pattern as POSTGRES_HOST/REDIS_URL/MINIO_ENDPOINT above.
OTEL_ENABLED=true
OTEL_EXPORTER_ENDPOINT=http://localhost:4318/v1/traces

# Grafana admin password (local dev only — anonymous Admin access is also enabled in
# docker-compose.yml for convenience, don't reuse this setup for anything internet-facing).
GRAFANA_ADMIN_PASSWORD=admin

# Optional — powers the web.search tool (app/tools/web_tools.py). Left empty, that tool fails
# with a clear "not configured" error rather than silently doing nothing. Free tier available at
# https://tavily.com — 1,000 searches/month, no credit card required.
TAVILY_API_KEY=
