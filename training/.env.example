# Krixil api service — training/ authenticates the same way any other client would (no separate
# service-account system). Use the real account whose conversation history should be trained on.
KRIXIL_API_BASE_URL=http://localhost:8000/api/v1
KRIXIL_TENANT_SLUG=
KRIXIL_EMAIL=
KRIXIL_PASSWORD=
# Only needed if 2FA is enabled on this account.
KRIXIL_TOTP_CODE=

# Native Ollama, same machine — no host.docker.internal indirection needed here.
KRIXIL_OLLAMA_BASE_URL=http://localhost:11434

# Which currently-installed Ollama chat model to fine-tune from.
KRIXIL_BASE_MODEL_TAG=qwen2.5:7b

# How often the scheduler checks readiness / for a pending manual request.
KRIXIL_FINETUNE_POLL_SECONDS=3600

# Where fine-tuning checkpoints and exported GGUF files are written during a run (cleaned up
# after each run, successful or not).
KRIXIL_FINETUNE_WORKDIR=./finetune_workdir
